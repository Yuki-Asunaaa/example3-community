  "narrative": {
    "northStar": "明亮科学图谱",
    "overview": "以明亮、清晰的科学图谱承载可操作的数据关系。灰蓝背景衬托白色工作面，细边界组织信息，分类色服务社区识别。中文系统字体与直接的操作标签使探索和阅读保持连续。",
    "keyCharacteristics": [
      "白色工作面与灰蓝底色",
      "分类色与编号共同标识社区",
      "平面分区、细边界、清晰焦点",
      "图形探索与中文说明互相补充"
    ],
    "rules": [
      {
        "name": "The Category Rule",
        "body": "社区颜色表示身份，编号和文字共同传达信息，不表示优劣。",
        "section": "colors"
      }
